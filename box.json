{
	"name": "BoxLang TOML Support",
	"version": "@build.version@+@build.number@",
	"location": "https://downloads.ortussolutions.com/ortussolutions/boxlang-modules/bx-toml/@build.version@/bx-toml-@build.version@.zip",
	"author": "Ortus Solutions",
	"homepage": "https://github.com/ortus-boxlang/bx-toml",
	"documentation": "https://github.com/ortus-boxlang/bx-toml",
	"repository": {
		"type": "git",
		"URL": "https://github.com/ortus-boxlang/bx-toml"
	},
	"bugs": "https://ortussolutions.atlassian.net/browse/BLMODULES",
	"slug": "bx-toml",
	"shortDescription": "Full TOML 1.0.0 parsing and serialization for BoxLang, with best-effort TOML 1.1 opt-in support",
	"type": "boxlang-modules",
	"keywords": [
		"boxlang",
		"toml",
		"parser",
		"serializer",
		"config"
	],
	"boxlang": {
		"minimumVersion": "1.0.0",
		"moduleName": "bxtoml"
	},
	"private": false,
	"license": [
		{
			"type": "Apache-2.0",
			"URL": "https://www.apache.org/licenses/LICENSE-2.0"
		}
	],
	"devDependencies": {
		"commandbox-boxlang": "*",
		"commandbox-cfformat": "*",
		"commandbox-docbox": "*",
		"testbox": "*"
	},
	"ignore": [
		"**/.*",
		"settings.gradle",
		"gradlew.bat",
		"gradlew",
		"build.gradle",
		"/src/**",
		"gradle/**"
	],
	"scripts": {
		"setupTemplate": "task run taskFile=src/build/SetupTemplate.cfc",
		"onRelease": "publish"
	}
}